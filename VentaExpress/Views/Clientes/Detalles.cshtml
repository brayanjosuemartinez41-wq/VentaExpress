@model VentaExpress.Models.Cliente

<div class="container mt-4">
    <h2>Detalles Cliente</h2>

    <div class="card p-3">
        <h4>@Model.Nombre</h4>
        <p class="mb-1"><strong>Teléfono:</strong> @Model.Telefono</p>
        <p class="mb-1"><strong>Correo:</strong> @Model.Email</p>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
            <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
        </div>
    </div>
</div>