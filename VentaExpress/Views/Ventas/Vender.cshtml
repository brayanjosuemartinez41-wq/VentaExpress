@model VentaExpress.Models.VenderViewModel

<div class="container mt-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold">Vender Producto</h2>
    </div>

    <div class="card p-4">
        <h4>@Model.Nombre</h4>
        <p class="text-muted mb-1">Categoria: @Model.Categoria</p>
        <p>@Model.Descripcion</p>

        <div class="row mt-3">
            <div class="col-md-4">
                <strong>Precio:</strong> @($"${Model.Precio:0.00}")
            </div>
            <div class="col-md-4">
                <strong>Cantidad disponible:</strong> @Model.Cantidad
            </div>
            <div class="col-md-4">
                <strong>Subtotal:</strong> @($"${Model.Precio * Model.Cantidad:0.00}")
            </div>
        </div>

        <form asp-action="Vender" method="post" class="mt-4 row g-2">
            @Html.AntiForgeryToken()
            <input asp-for="ProductoId" type="hidden" />
        <div class="col-12">
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
            <div class="col-md-4">
            <label class="form-label">Cliente</label>
            <select asp-for="ClienteId" class="form-select" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(ViewBag.Clientes, "Id", "Nombre"))">
                <option value="">-- Seleccione cliente --</option>
            </select>
            <span class="text-danger" asp-validation-for="ClienteId"></span>
        </div>
            <div class="col-md-4">
                <label class="form-label">Cantidad a vender</label>
                <input asp-for="Cantidad" type="number" class="form-control" min="1" max="@Model.CantidadDisponible" />
                <span class="text-danger" asp-validation-for="Cantidad"></span>
            </div>
            <div class="col-md-8 d-flex align-items-end">
                <button type="submit" class="btn btn-success me-2">Vender</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>