@model List<VentaExpress.Models.Producto>
@using System.Globalization

<div class="container mt-5">

    <div class="text-center mb-4">
        <div style="font-size:2.2rem;">🛒</div>
        <h1 class="fw-bold">VentaExpress</h1>
    </div>

    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="Crear" class="btn btn-success btn-lg rounded-3">Agregar Producto</a>
            <div>
                <a asp-action="ExportCsv" class="btn btn-outline-secondary me-2">Exportar CSV</a>
            </div>
        </div>

        <form method="get" asp-action="Index" class="row g-2">
            <div class="col-md-4">
                <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Buscar por nombre o descripción" />
            </div>
            <div class="col-md-3">
                <select name="category" class="form-select">
                    <option value="">Todas las categorias</option>
                    @if (ViewBag.Categorias != null)
                    {
                        foreach (var c in (List<string>)ViewBag.Categorias)
                        {
                            if (ViewBag.Category == c)
                            {
                                <option value="@c" selected>@c</option>
                            }
                            else
                            {
                                <option value="@c">@c</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="sortOrder" class="form-select">
                    @if (string.IsNullOrEmpty(ViewBag.SortOrder as string))
                    {
                        <option value="" selected>Ordenar por nombre</option>
                    }
                    else
                    {
                        <option value="">Ordenar por nombre</option>
                    }

                    @if ((ViewBag.SortOrder as string) == "precio_asc")
                    {
                        <option value="precio_asc" selected>Precio ascendente</option>
                    }
                    else
                    {
                        <option value="precio_asc">Precio ascendente</option>
                    }

                    @if ((ViewBag.SortOrder as string) == "precio_desc")
                    {
                        <option value="precio_desc" selected>Precio descendente</option>
                    }
                    else
                    {
                        <option value="precio_desc">Precio descendente</option>
                    }

                    @if ((ViewBag.SortOrder as string) == "cantidad_asc")
                    {
                        <option value="cantidad_asc" selected>Cantidad ascendente</option>
                    }
                    else
                    {
                        <option value="cantidad_asc">Cantidad ascendente</option>
                    }

                    @if ((ViewBag.SortOrder as string) == "cantidad_desc")
                    {
                        <option value="cantidad_desc" selected>Cantidad descendente</option>
                    }
                    else
                    {
                        <option value="cantidad_desc">Cantidad descendente</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">Aplicar</button>
            </div>
        </form>

        @if (TempData["mensaje"] != null)
        {
            <div class="alert alert-success mt-2">@TempData["mensaje"]</div>
        }
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex justify-content-between">
                            <div>
                                <h4 class="card-title">@item.Nombre</h4>

                                <p class="mb-2"><i class="bi bi-tag-fill me-2"></i> @($"${item.Precio:0.00}")</p>
                                <p class="mb-2"><i class="bi bi-stack me-2"></i> Cantidad: @item.Cantidad</p>
                                <p class="mb-0"><i class="bi bi-calculator me-2"></i> Subtotal: <strong>@($"${(item.Precio * item.Cantidad):0.00}")</strong></p>
                            </div>

                            <div class="d-flex flex-column gap-2 align-items-end">
                                <a asp-action="Detalles" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">[Detalles]</a>
                                <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-primary btn-sm">[Editar]</a>
                                <a asp-action="ConfirmarEliminar" asp-route-id="@item.Id" class="btn btn-danger btn-sm">[Eliminar]</a>
                                <a asp-action="Vender" asp-route-id="@item.Id" class="btn btn-success btn-sm">[Vender]</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">No hay productos</div>
            </div>
        }
    </div>

    @{
        var total = Model?.Sum(p => p.Precio * p.Cantidad) ?? 0m;
    }
    <div class="d-flex justify-content-center mt-4">
        <div class="card shadow-sm py-3 px-4">
            <h4 class="fw-bold mb-0"><i class="bi bi-calculator me-2"></i> Total: <span>@($"${total:0.00}")</span></h4>
        </div>
    </div>

</div>