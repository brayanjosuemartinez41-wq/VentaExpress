@model List<VentaExpress.Models.Producto>
@using System.Globalization

<div class="container mt-5">

    <div class="text-center mb-4">
        <div style="font-size:2.2rem;">🛒</div>
        <h1 class="fw-bold">VentaExpress</h1>
    </div>

    <form asp-action="Agregar" method="post" class="row g-3 align-items-center mb-4">
        <div class="col-lg-5">
            <input type="text" name="Nombre" class="form-control form-control-lg rounded-3" placeholder="Producto" required />
        </div>

        <div class="col-lg-3">
            <input type="number" step="0.01" name="Precio" class="form-control form-control-lg rounded-3" placeholder="Precio" required />
        </div>

        <div class="col-lg-2">
            <input type="number" name="Cantidad" class="form-control form-control-lg rounded-3" placeholder="Cantidad" required />
        </div>

        <div class="col-lg-2 d-grid">
            <button type="submit" class="btn btn-success btn-lg rounded-3">Agregar</button>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" style="width:40%;">Producto</th>
                        <th scope="col" style="width:15%;">Precio</th>
                        <th scope="col" style="width:15%;">Cantidad</th>
                        <th scope="col" style="width:20%;">Subtotal</th>
                        <th scope="col" style="width:10%;">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">@item.Nombre</td>
                                <td class="text-center">@($"${item.Precio:0.00}")</td>
                                <td class="text-center">@item.Cantidad</td>
                                <td class="text-center fw-bold">@($"${(item.Precio * item.Cantidad):0.00}")</td>
                                <td class="text-center">
                                    <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-3">No hay productos</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @{
        var total = Model?.Sum(p => p.Precio * p.Cantidad) ?? 0.0;
    }
    <div class="d-flex justify-content-end mt-4">
        <h3 class="fw-bold">Total: <span class="text-dark">@($"${total:0.00}")</span></h3>
    </div>

</div>