@model VentaExpress.Models.Producto

<div class="container mt-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold">Detalles del Producto</h2>
    </div>

    <div class="card p-4">
        <h4>@Model.Nombre</h4>
        <p class="text-muted mb-1">Categoria: @Model.Categoria</p>
        <p>@Model.Descripcion</p>

        <div class="row mt-3">
            <div class="col-md-4">
                <strong>Precio:</strong> @($"${Model.Precio:0.00}")
            </div>
            <div class="col-md-4">
                <strong>Cantidad:</strong> @Model.Cantidad
            </div>
            <div class="col-md-4">
                <strong>Subtotal:</strong> @($"${Model.Subtotal:0.00}")
            </div>
        </div>

        <div class="mt-4">
            <a asp-action="Index" class="btn btn-secondary me-2">Volver</a>
            <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
        </div>
    </div>
</div>